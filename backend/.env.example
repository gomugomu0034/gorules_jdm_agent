# Copy to backend/.env and fill in. This file is a template; .env is gitignored.

# ---------------------------------------------------------------- LLM
# Only the assistant needs this. The editor, simulator, test runner and
# import/export all work without it.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=

# ---------------------------------------------------------------- Identity
# Signs the session cookie. Without it a new key is generated on every restart,
# which signs every guest out and detaches them from their saved policies.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# The single admin account. Leave ADMIN_PASSWORD empty to disable sign-in
# entirely; the guest flow still works. Nothing here is committed.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# How long an inactive guest's policies are kept before being swept.
GUEST_TTL_DAYS=30

# ---------------------------------------------------------------- Training corpus
# Records every model call - prompt, completion, reasoning, token counts, cost,
# the model that actually served it, and the node that made it - plus what the
# parser, linter and test engine then made of each one, and what you then did with
# it - clarifications, approvals, rejections and your own edits to the agent's
# graphs - into its own SQLite file, for fine-tuning the planner and builder.
# Kept separate from studio.db deliberately: deleting a conversation cascades away
# the studio's record of it, and a corpus gathered over months must survive that.
#
# On by default. Set to "off" to record nothing; the agent is unaffected either way.
CORPUS_CAPTURE=on
# Defaults to <repo>/data/corpus.db. Under Docker that is inside the `studio_data`
# named volume, so export it with:
#   docker compose cp backend:/app/data/corpus.db ./corpus.db
#CORPUS_DB_PATH=
#
# Read it with:
#   python -m backend.corpus.export --format stats
#   python -m backend.corpus.export --format sft --min-quality 1.0 --out sft.jsonl
# Exports are scrubbed for addresses and key-shaped tokens by default; that is a
# reduction in risk, not a guarantee, so read one before sending it anywhere.
#
# Build volume faster than a person can click, and recover past conversations:
#   python -m backend.corpus.replay --dry-run          # what would run
#   python -m backend.corpus.replay --max-runs 2       # spends real model quota
#   python -m backend.corpus.backfill --dry-run
# Both mark what they write, so `--source live` on an export keeps real use apart
# from synthetic drills and reconstructed history.
